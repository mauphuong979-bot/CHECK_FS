# Sao chép thành .streamlit/secrets.toml (máy cục bộ) hoặc dán vào
# Streamlit Cloud > App settings > Secrets. KHÔNG commit secrets.toml.

# ---------------------------------------------------------------------------
# Đăng nhập
# ---------------------------------------------------------------------------
[auth]
# Khóa ký cookie "Ghi nhớ đăng nhập" (tối thiểu 16 ký tự, ngẫu nhiên).
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Đổi khóa này sẽ buộc mọi trình duyệt đã ghi nhớ phải đăng nhập lại.
cookie_secret = "thay-bang-chuoi-ngau-nhien-dai"
remember_days = 30

# Tài khoản khởi tạo. Khi đã cấu hình Google Sheet, các tài khoản này được chép
# (mật khẩu đã băm) vào worksheet "Users" ở lần chạy đầu; sau đó Google Sheet là
# nguồn chính và mật khẩu ở đây chỉ dùng làm dự phòng khi mất kết nối.
# role: "admin" (Quản trị viên) hoặc "user" (Người dùng).
[auth.users.VPSG]
password = "doi-mat-khau-VPSG"
role = "admin"

[auth.users.VPBD]
password = "doi-mat-khau-VPBD"
role = "user"

[auth.users.user]
password = "doi-mat-khau-user"
role = "user"

# ---------------------------------------------------------------------------
# Google Sheet lưu tài khoản (worksheet "Users") và nhật ký sử dụng ("Logs").
# Dán nội dung tệp JSON khóa service account; chia sẻ bảng tính cho client_email
# với quyền Editor. Bỏ trống/không khai báo mục này thì ứng dụng dùng tài khoản
# ở [auth.users] ở chế độ chỉ đọc (chưa đổi được mật khẩu, chưa lưu nhật ký).
# ---------------------------------------------------------------------------
# [connections.gsheets]
# spreadsheet = "https://docs.google.com/spreadsheets/d/<ID>/edit"
# type = "service_account"
# project_id = ""
# private_key_id = ""
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = ""
# client_id = ""
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = ""
# universe_domain = "googleapis.com"
